{
  "name": "storybound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --watch apps/server/src/index.ts",
    "dev:web": "bun --cwd apps/web dev",
    "assets:generate": "bun apps/web/scripts/generate-covers.ts",
    "build": "bun run typecheck && bun --cwd apps/web build",
    "typecheck": "tsc -b",
    "check": "biome check . --diagnostic-level=error",
    "check:fix": "biome check --write . --diagnostic-level=error",
    "compile": "bun --cwd apps/server compile",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --diagnostic-level=error",
    "lint:all": "biome lint .",
    "start": "NODE_ENV=production bun apps/server/src/index.ts",
    "test": "bun --cwd packages/shared test && bun --cwd apps/server test && bun --cwd apps/web test",
    "test:e2e": "playwright test",
    "test:watch": "bun test --watch packages/shared/tests apps/server/tests apps/web/tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "concurrently": "10.0.5",
    "typescript": "7.0.2"
  }
}
